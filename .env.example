# Supabase — project URL and keys
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server only. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Brevo — certificate delivery. Server only.
BREVO_API_KEY=your-brevo-api-key
BREVO_SENDER_EMAIL=certificates@devtrackacademy.com
BREVO_SENDER_NAME=DevTrackAcademy

# Public base URL. Used for QR codes, verification links and email buttons.
NEXT_PUBLIC_APP_URL=https://certificates.devtrackacademy.com

# Comma-separated admin allowlist for /admin.
ADMIN_EMAILS=admin@devtrackacademy.com

# Must match Supabase > Authentication > Providers > Email > "Email OTP Length".
# Supabase's default is 6; this project's Supabase is set to 8.
NEXT_PUBLIC_OTP_LENGTH=8
